# Local runs can use `vercel login`; CI should use VERCEL_TOKEN.
VERCEL_TOKEN=

# Required. Your Vercel team/account scope (find it with `vercel teams ls`).
VERCEL_SCOPE=

# Optional. Windows example:
# VERCEL_CLI=C:\Users\you\AppData\Roaming\npm\vercel.cmd
VERCEL_CLI=

# Optional. Use 1 to make CI fail when a project is critical.
FAIL_ON_CRITICAL=0
